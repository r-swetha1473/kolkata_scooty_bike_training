{
  "name": "kolkata-scotty-backend",
  "version": "1.0.0",
  "description": "Backend API for Kolkata Scotty Bike Training",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations/run.js",
    "test:endpoints": "NODE_ENV=test node test/endpoints.test.js",
    "validate": "node --check server.js && node --check routes/admin.js && node --check routes/auth.js",
    "docker:build": "docker build -t biketraining-backend .",
    "docker:run": "docker run -p 3000:3000 --env-file .env biketraining-backend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
