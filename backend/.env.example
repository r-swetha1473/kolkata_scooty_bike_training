# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# --- Database (use DATABASE_URL OR individual vars) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DB_SSL=true
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=biketraining
# DB_USER=postgres
# DB_PASSWORD=
DB_POOL_MAX=10

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-session-secret

# --- Google OAuth (customer sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Console "Authorized redirect URIs", e.g.:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Frontend (CORS + OAuth redirect target) ---
FRONTEND_URL=http://localhost:4200
# Optional: Vercel preview URL for CORS
# FRONTEND_URL_PREVIEW=

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Email (optional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ADMIN_ALERT_EMAIL=

# --- Customer inactivity (optional cron) ---
# DISABLE_INACTIVITY_CRON=1
# INACTIVITY_CRON=0 2 * * *
# INACTIVITY_BLOCK_DAYS=45

# --- Nightly slot auto-generation (optional) ---
# DISABLE_AUTO_SLOT_CRON=1
# AUTO_SLOT_CRON=0 0 * * *
# AUTO_SLOT_CRON_TZ=Asia/Kolkata
# AUTO_SLOT_RUN_ON_START=1

# --- Debug ---
# LOG_BOOKING_DEBUG=1

# --- WhatsApp (optional) ---
# WHATSAPP_PROVIDER=
# WHATSAPP_API_KEY=
# WHATSAPP_API_URL=
# ADMIN_PHONE=
